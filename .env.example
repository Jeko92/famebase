# Database
# Local development
DATABASE_URL="postgresql://your_username@localhost:5432/addfame_famebase"

# Production (use one of these services):
# Neon: postgresql://[user]:[password]@[host]/[db]?sslmode=require
# Supabase: postgresql://[user]:[password]@[host]:[port]/[db]
# Vercel Postgres: get from Vercel dashboard after creating database

# Next.js
# Local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://your-app-name.vercel.app

# NextAuth
# Local development
NEXTAUTH_URL="http://localhost:3000"
# Production: https://your-app-name.vercel.app

# Generate a secure secret with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-min-32-chars-change-in-production"
NEXTAUTH_SECRET="your-secret-key-min-32-chars-change-in-production"

# Optional: if using external image storage
# NEXT_PUBLIC_IMAGE_CDN_URL=""